{
  "name": "blog-engine",
  "version": "0.13.0",
  "description": "",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "blog-engine-review": "./dist/cli/review.js",
    "blog-engine-rewrite": "./dist/cli/rewrite.js",
    "blog-engine-repair": "./dist/cli/repair.js"
  },
  "files": [
    "dist",
    "examples"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/cli/review.js', 0o755); require('fs').chmodSync('dist/cli/rewrite.js', 0o755); require('fs').chmodSync('dist/cli/repair.js', 0o755);\"",
    "prepare": "npm run build",
    "clean": "rm -rf dist",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "smoke:xai": "npx tsx scripts/xai-smoke.ts",
    "wiki:ingest": "npx tsx scripts/wiki-ingest.ts",
    "wiki:lint": "npx tsx scripts/wiki-lint.ts"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.40.0",
    "@google/genai": ">=2.5.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@google/genai": "^2.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
